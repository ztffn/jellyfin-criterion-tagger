function buildStremioURL(options) {
  const base = 'stremio://1fe84bc728af-stremio-mdblist.baby-beamup.club';
  let parts = [base];

  if (options.mode === 'slug') {
    if (!options.slug || !options.username) {
      alert('Missing slug/username!');
      return null;
    }
    if (options.isUnified) {
      parts.push('unified');
    }
    parts.push(options.slug);
    parts.push(`userapi-${options.username}-${options.apiKey}`);
  } else if (options.mode === 'external') {
    if (!options.listId) {
      alert('Missing list ID!');
      return null;
    }
    if (options.isUnified) {
      parts.push('unified-external');
    } else {
      parts.push('external');
    }
    parts.push(options.listId);
    parts.push(options.apiKey);
  } else if (options.mode === 'watchlist') {
      if (!options.apiKey) {
          alert('Missing MDBList API key!');
          return null;
      }
      if (options.isUnified) {
          parts.push('unified-watchlist');
      } else {
          parts.push('watchlist');
      }
      parts.push(options.apiKey);
  } else {
    if (!options.listId) {
      alert('Missing list ID!');
      return null;
    }
    if (options.isUnified) {
      parts.push('unified');
    }
    parts.push(options.listId);
    parts.push(options.apiKey);
  }

  if (options.unifiedName) {
    parts.push(options.unifiedName);
  }
  if (options.rpdbApi) {
    parts.push(options.rpdbApi);
  }

  parts.push('manifest.json');
  return parts.join('/');
}

function openStremio(options) {
    const url = buildStremioURL(options);
    if (url) {
        window.location.href = url;
    }
}

  

