<script>

var addedLists = [];
var dropdownOptions = [];

jQuery(function(){
  var minimized_elements = $('div.description');
  minimized_elements.each(function(){    
      var t = $(this).text();        
      if(t.length < 400) return;
      $(this).html(
          t.slice(0,300)+'<span>... </span><a href="#" class="more">More</a>'+
          '<span style="display:none;">'+ t.slice(300,t.length)+' <a href="#" class="less">Less</a></span>'
      );
  }); 
  $('a.more', minimized_elements).click(function(event){
      event.preventDefault();
      $(this).hide().prev().hide();
      $(this).next().show();        
  });
  $('a.less', minimized_elements).click(function(event){
      event.preventDefault();
      $(this).parent().hide().prev().show().prev().show();    
  });
});

$('.message .close').on('click', function() {
$(this)
  .closest('.message')
  .transition('fade')
;});

function initPopups() {
  $('.icon').popup();
  $('.needpopup').popup();
}


$(document).on('click', '.cstaticlist.nonsupporter.popup.icon.item', function() {    
  $('body').modal('alert','Supporter Only','Creating Static List from existing list is Supporter Only Feature');
});
$(document).on('click', '.appendstaticlist.nonsupporter.popup.icon.item', function() {    
  $('body').modal('alert','Supporter Only','Appending to Static List from existing list is a supporter-only feature.');
});
$(document).on('click', '.cstaticlist.supporter.popup.icon.item', function() {    
  var list_id = $(this).attr('data-value')
  var list_name = $('#listname_'+list_id).attr('value')
  $('#modal_static_name').attr('value',list_name)
  $('#modal_static_list').modal({
    title: 'Create Static List ['+list_name+']',
    onApprove: function(e) {
      if (e.hasClass('trakt')) {
      var trakt = 1
      }
      else {
        var trakt = 0
      }
      new_list_name = $('#modal_static_name').val()
      if (new_list_name) {
        $('#s_list_id').val(list_id);
        $('#s_list_name').val(new_list_name);
        $('#s_trakt').val(trakt);
        $('#s_action').val('createstaticlist');
        $('#Form').submit();
      }
    }
  }).modal('show');;  
});    


$(document).on('click', '.appendstaticlist.supporter.popup.icon.item', function() {
    var list_id = $(this).attr('data-value');
    var list_name = $('#listname_'+list_id).attr('value');
    
    $('#append_static_list_dropdown').dropdown();
    
    $('#modal_append_static_list').modal({
        title: 'Append to Static List ['+list_name+']',
        onApprove: function(e) {
            var selected_list_id = $('#append_static_list_dropdown').val();
            if (selected_list_id && selected_list_id !== '') {
                var $approveButton = $('.ui.approve.button');
                $approveButton.addClass('disabled loading');
                
                appendToStaticList(list_id, selected_list_id);
            } else {
                $('body').toast({
                    class: 'error',
                    message: '<i class="times circle icon"></i> Please select a static list',
                    showProgress: 'bottom',
                    displayTime: 5000,
                });
                return false;
            }
            return false;
        }
    }).modal('show');
});

function appendToStaticList(source_list_id, target_list_id) {
    $.ajax({
        url: '/ajax/append-to-static-list/',
        type: 'POST',
        data: {
            'source_list_id': source_list_id,
            'target_list_id': target_list_id,
            'list_type': ''.trim() ? 'external' : 'normal',
            'csrfmiddlewaretoken': getCSRFToken(),
        },
        dataType: 'json',
        success: function(response) {
            var $approveButton = $('.ui.approve.button');
            $approveButton.removeClass('disabled loading');
            
            if (response.success) {
                $('body').toast({
                    class: 'success',
                    message: '<i class="check circle icon"></i> ' + (response.message || 'Successfully appended to static list'),
                    showProgress: 'bottom',
                    displayTime: 3000,
                });
                $('#modal_append_static_list').modal('hide');
            } else {
                $('body').toast({
                    class: 'error',
                    message: '<i class="times circle icon"></i> ' + (response.error || 'Error appending to static list'),
                    showProgress: 'bottom',
                    displayTime: 5000,
                });
            }
        },
        error: function(xhr, status, error) {
            var $approveButton = $('.ui.approve.button');
            $approveButton.removeClass('disabled loading');
            $('body').toast({
                class: 'error',
                message: '<i class="times circle icon"></i> Network error occurred. Please try again.',
                showProgress: 'bottom',
                displayTime: 5000,
            });
        }
    });
}

$(document).on('click', '.removetrakt.icon.item', function() {
  var traktid = $(this).attr('data-value')
  $( "div.content.delete" ).html( 'Are you really want to disable Trakt Sync for this Lists? This cannot be undone.' );
    $('#mdldel')
    .modal({
      onApprove : function() {
        $('#s_traktid').val(traktid);
        $('#s_action').val('removetraktsync');
        $('#Form').submit();
      }
    })
    .modal('show');
});    

$(document).on('click', '.clinkedlist.popup.icon.item', function() {    
  var list_id = $(this).attr('data-value')
  $.ajax({
    url: '/ajax/list_notification/',
    data: {
      'listid': list_id,
      'action': 'create_linked_list'
    },
    dataType: 'json',
    success: function (data) {
      if (data["response"] == 200) {
        $('body')
          .toast({
            class: 'success',
            message: 'Linked List Created',
          })
        ;
      }
      else if (data["response"] == 4001) {
            $('body').toast({
                class: 'error',
                message: data["message"],
              });            
      }
    }
  });
});      

$(document).on('click', '.floating.ui.mrating', function() {
  objme = $(this);
  var traktid = $(this).attr('data-traktid')
  var mediatype = $(this).attr('data-mediatype')
  var f_title = $('#id_'+traktid+'_title').attr('value')
  var f_rating = $('#id_'+traktid+'_rating').attr('value')
  $( "p.modal.rate" ).html(f_title);
  $('.ui.red.rating')
    .rating({
      icon: 'star',
      initialRating: f_rating,
      maxRating: 10,
      clearable: true
    })
  ;
  $('#mdodal_rate')
  .modal({
    onApprove : function() {
      f_rating = $('.ui.red.rating')
        .rating('get rating')
      ;
      $.ajax({
        url: '/ajax/trakt_rating/',
        data: {
          'traktid': traktid,
          'rating': f_rating,
          'media': mediatype
        },
        dataType: 'json',
        success: function (data) {
          if (data["response"] == 200) {
            if (f_rating == 0) {
              objme.removeClass('floating ui red label');
              objme.addClass('floating ui grey label');
              objme.text('+');
              $('#id_'+traktid+'_rating').attr('value', f_rating)
            }
            else {
              objme.removeClass('floating ui grey label');
              objme.addClass('floating ui red label');
              objme.text(f_rating);
              $('#id_'+traktid+'_rating').attr('value', f_rating)
            }
            $('body').toast({
                class: 'success',
                message: 'Rating registered with Trakt',
              });            
          }
          else {
            $('body').toast({
                class: 'error',
                message: 'Error registering rating with Trakt',
              });            
          }
        }
      });    
    }
  }).modal('show');
});    

$(document).on('click', '.floating.ui.usort', function() {    
  objme = $(this);
  var media_id = $(this).attr('data-id')
  var media_type = $(this).attr('data-mediatype')
  var list_id = $(this).attr('data-listid')
  var title = $(this).attr('data-mtitle')
  var user_sort = $(this).attr('data-usort')
  $( "p.modal.usort.title" ).html(title);
  $('#input_sort_number').val(user_sort);
  $('#mdodal_usort')
  .modal({
    onApprove : function() {
      usort_val = $('#input_sort_number').val();
      if (usort_val == '') {
        usort_val = 0
      }
      if ($.isNumeric(usort_val) && usort_val >= 0 && usort_val < 10000)
        $.ajax({
          url: '/ajax/user_sort/',
          data: {
            'media_id': media_id,
            'media_type': media_type,
            'user_sort': usort_val,
            'list_id': list_id
          },
          dataType: 'json',
          success: function (data) {
            if (data["response"] == 200) {
              if (usort_val == 0) {
                objme.text('+');
                objme.attr('data-usort', '');
                objme.addClass('empty');
              }
              else {
                objme.text(usort_val);
                objme.attr('data-usort', usort_val);
                objme.removeClass('empty');
              }
              $('body').toast({
                  class: 'success',
                  message: 'User Sort Added',
                });            
            }
            else {
              $('body').toast({
                  class: 'error',
                  message: 'Error Adding User Sort',
                });            
            }
          }
        });    
    }
  }).modal('show');
});    


$('select.ui.mlists.dropdown')
  .find('option')
  .each(function () {
    var value = $(this).attr('value');
    var name = $(this).text();
    if (value) {
      dropdownOptions.push({ id: value, name: name });
    }
  });

$(document).on('click', '.icon.mlists.list', function () {
  const mdbid = $(this).data('id');
  const mediatype = $(this).data('mediatype');
  const title = $(this).data('title') || 'Untitled';

  const rawValue = $(`#slist_${mdbid}_${mediatype}`).val() || '';
  const cleaned = rawValue.replace(/\s+/g, '').replace(/^,|,$/g, '');
  const slistsArr = cleaned ? cleaned.split(',') : [];

  const $dropdown = $('#mdodal_lists .ui.mlists.dropdown').dropdown('clear');
  $dropdown.dropdown('set exactly', slistsArr);

  $('#mdodal_lists .header.mtitle').text(`Static lists for ${title}`);

  $('#mdodal_lists').modal({
    onApprove() {
      const selected = $dropdown.dropdown('get value') || [];
      const joined = Array.isArray(selected) ? selected.join(',') : selected;

      $(`#slist_${mdbid}_${mediatype}`).val(joined);

      // Update *all* icons for same mdbid + mediatype (desktop + mobile)
      $(`.icon.mlists.list[data-id="${mdbid}"][data-mediatype="${mediatype}"]`)
        .removeClass('blue grey')
        .addClass(joined.length ? 'blue' : 'grey');

      // Save
      $.ajax({
        url: '/ajax/static_lists/',
        data: { mdbid: mdbid, mediatype: mediatype, slists: selected },
        traditional: true,
        dataType: 'json',
        success(data) {
          $('body').toast({
            class: data.response === 200 ? 'success' : 'error',
            message: data.response === 200 ? 'Static list changes saved' : 'Error saving changes to Trakt, try again'
          });
        }
      });
      saveSelectedLists(Array.isArray(selected) ? selected : selected.split(','));
    }
  }).modal('show');
});

function saveSelectedLists(selectedValues) {
  addedLists = selectedValues
    .map(function (listId) {
      var list = dropdownOptions.find((option) => option.id === listId);
      return list ? { id: list.id, name: list.name } : null;
    })
    .filter(Boolean);

  renderAddedLists();
}

function renderAddedLists() {
  var $addedListsContainer = $('.added-lists');
  $addedListsContainer.empty();

  addedLists.forEach(function (list) {
    $('<div>', {
      class: 'ui label',
      'data-value': list.id,
      text: list.name,
    })
      .append(
        $('<span>', {
          class: 'last-selected',
          text: 'Last Selected',
        })
      )
      .appendTo($addedListsContainer);
  });
}

$(document).on('click', '.added-lists .ui.label', function () {
  var listId = $(this).data('value');
  $('.ui.mlists.dropdown').dropdown('set selected', [listId]);
});



// Mark as unwatched / Unwatched
$(document).on('click', '.icon.link.floated.circle', function() {    
  var traktid = $(this).attr('data-traktid')
  var mediatype = $(this).attr('data-mediatype')
  objme = $(this);
  if ( $(this).hasClass("icon purple link floated play circle") ) { 
    $.ajax({
      url: '/ajax/trakt_watched/',
      data: {
        'traktid': traktid,
        'action': 'remove',
        'media': mediatype
      },
      dataType: 'json',
      success: function (data) {
        if (data["response"] == 200) {
          objme.removeClass('icon purple link floated play circle');
          objme.addClass('icon grey link floated play circle outline');
          objme.attr('data-content', 'Mark as Watched');
          $('body').toast({
                  class: 'success',
                  message: 'Marked as Unwatched',
                  showIcon: 'play circle outline',
                  showProgress: 'bottom',
                });
        }
      }
    });    
  }
  else {
    $.ajax({
      url: '/ajax/trakt_watched/',
      data: {
        'traktid': traktid,
        'action': 'add',
        'media': mediatype
      },
      dataType: 'json',
      success: function (data) {
        if (data["response"] == 200) {
          objme.removeClass('icon grey link floated play circle outline');
          objme.addClass('icon purple link floated play circle');
          objme.attr('data-content', 'Mark as Unwatched');
          $('body').toast({
                  class: 'success',
                  message: 'Marked as Watched',
                  showIcon: 'play circle outline',
                  showProgress: 'bottom',
                });
        }
      }
    });    
  }
});    

// Add to watch / remove from watch list
// $('.icon.link.floated.stream').click(function(){
$(document).on('click', '.icon.link.floated.stream', function() {    
  var traktid = $(this).attr('data-traktid')
  var mediatype = $(this).attr('data-mediatype')
  objme = $(this);
  if ( $(this).hasClass("icon blue link floated stream") ) {   
    $.ajax({
      url: '/ajax/trakt_added/',
      data: {
        'traktid': traktid,
        'action': 'remove',
        'media': mediatype
      },
      dataType: 'json',
      success: function (data) {
        if (data["response"] == 200) {
          objme.removeClass('icon blue link floated stream');
          objme.addClass('icon grey link floated stream');
          objme.attr('data-content', 'Add to Watched list');
          $('body').toast({
                  class: 'success',
                  message: 'Removed from Watched List',
                  showIcon: 'stream',
                  showProgress: 'bottom',
                });
        }
      }
    });    
  }
  else {
    $.ajax({
      url: '/ajax/trakt_added/',
      data: {
        'traktid': traktid,
        'action': 'add',
        'media': mediatype
      },
      dataType: 'json',
      success: function (data) {
        if (data["response"] == 200) {
          objme.removeClass('icon grey link floated stream');
          objme.addClass('icon blue link floated stream');
          objme.attr('data-content', 'Remove from Watched list');
          if (data["trakt_error"]) {
            $('body').toast({
              class: 'yellow inverted',
              message: 'Successfully added to MDBList Watch List, <br>but there was an error syncing with Trakt.',
              showIcon: 'stream',
              showProgress: 'bottom',
            });
          } else {
            $('body').toast({
              class: 'success',
              message: 'Added to Watch List',
              showIcon: 'stream',
              showProgress: 'bottom',
            });
          }
        }
      }
    });    
  }
});    


// Exclude/Include Item
$(document).on('click', '.icon.mlists.eye.slash', function() {
  var input = $(this).attr('data-value')
  var listid = $('#listid').attr('value')
  objme = $(this);
  if ( $(this).hasClass("icon mlists eye slash grey link") ) { 
    $.ajax({
      url: '/ajax/exclude_item/',
      data: {
        'mdbid': input,
        'listid': listid,
        'action': 'exclude'
      },
      dataType: 'json',
      success: function (data) {
        if (data["response"] == 200) {
          objme.removeClass('icon mlists eye slash grey link');
          objme.addClass('icon mlists eye slash red link');
          objme.attr('data-content', 'This item is excluded, click to restore');
          $('body').toast({
                class: 'success',
                message: 'Will be removed from Trakt list on next refresh',
          });
        }
      }
    });    
  }
  else {
    $.ajax({
      url: '/ajax/exclude_item/',
      data: {
        'mdbid': input,
        'listid': listid,
        'action': 'include'
      },
      dataType: 'json',
      success: function (data) {
        if (data["response"] == 200) {
          objme.removeClass('icon mlists eye slash red link');
          objme.addClass('icon mlists eye slash grey link');
          objme.attr('data-content', 'Exclude this title from Trakt.tv, Radarr, RSS and Public view');
          $('body').toast({
                class: 'success',
                message: 'Will be restored to Trakt list on next refresh',
          });
        }
      }
    });    
  }
});    






$(document).on('click', '.ui.dropdown.mdblistarr .item', function() {
    var instance_id = $(this).data('value');
    var instanceDisplayName = $(this).text();
    
    var iconElement = $(this).closest('.ui.dropdown').find('.icon');
    
    var tmdbid = iconElement.data('tmdbid');
    var tvdbid = iconElement.data('tvdbid');
    
    if (tmdbid) {
        var mediatype = 'Movie';
        var client = 'Radarr';
    } else {
        var mediatype = 'Show';
        var client = 'Sonarr';
    }
    
    if (tmdbid || tvdbid) {
        var progressToast = $('body').toast({
            displayTime: 0,
            message: 'Please wait, adding to ' + client + ': ' + instanceDisplayName + '...'
        });
        
        $.ajax({
            url: '/ajax/mdblistarr_add/',
            type: "post",
            dataType: "json",
            data: JSON.stringify({
                'event': 'add' + mediatype,
                'tmdbId': tmdbid,
                'tvdbId': tvdbid,
                'instance_id': instance_id,
                'apikey': 'None'
            }),
            success: function (data) {
                if (data["code"] == 200) {
                    $('body').toast({
                        class: 'success',
                        message: mediatype + ' added to ' + client + ': ' + instanceDisplayName + ' queue',
                        showProgress: 'bottom',
                        displayTime: 5000,
                    });
                }
                else {
                    $('body').toast({
                        class: 'error',
                        message: 'Error Adding ' + mediatype + ' to ' + client + ': ' + instanceDisplayName + ', error code: '+data["code"],
                        showProgress: 'bottom',
                        displayTime: 5000,
                    });
                }
                setTimeout(function(){
                    progressToast.toast('close');
                }, 1000);
            },
            error: function(data) {
                var obj = JSON.parse(data.responseText)
                $('body').toast({
                    class: 'error',
                    message: obj.details.response,
                    showProgress: 'bottom',
                    displayTime: 5000,
                });
                setTimeout(function(){
                    progressToast.toast('close');
                }, 1000);
            }
        });
    }
});



function getCSRFToken() {
  return document.querySelector('meta[name="csrf-token"]').getAttribute('content');
}

$(".item.savesortorder").on("click", function() {
    let $icon = $(this);
    let sort = $("#sort").val();
    let sortOrder = $("#sortorder").val();

    $icon.closest(".item").addClass("disabled");

    $.ajax({
        url: "/ajax/save-sort-order/",
        type: "POST",
        data: { sort_order: sortOrder, sort: sort, list_id: $("#listid").val() },
        headers: { "X-CSRFToken": getCSRFToken() },
        success: function(response) {
            $('body')
              .toast({
                class: 'success',
                message: 'Sort order saved',
              })
            ;                
        },
        error: function() {
            $('body')
              .toast({
                class: 'error',
                message: 'Error saving sort order',
              })
            ;                
        }
    });
});  

$('.assign_tags_to_list').click(function(){
  objme = $(this);
  window.currentListId = $(this).attr('data-listid');
  var selected_tags = $('#selected_tags').attr('value')
  const listsarray = selected_tags.split(',');
  $('#existing_tags').dropdown('set exactly', listsarray);
  $('#modal_assign_tags').modal('show');
});


function saveTags() {
  var existing_tags = $('#existing_tags').dropdown('get value')

  existing_tags = Array.isArray(existing_tags) ? existing_tags : existing_tags.split(',');

  const newTag = $('#new_tag').val().trim();
  
  if (newTag && !existing_tags.includes(newTag)) {
    existing_tags.push(newTag); // Add newTag to the array
    const dropdownValues = existing_tags.map(tag => ({
      name: tag,
      value: tag,
      selected: true,
    }));    
    $('#existing_tags').dropdown('change values', dropdownValues);
  }

  const data = {
    'list_id': window.currentListId,
    'existing_tags': existing_tags,
    'new_tag': newTag,
    'csrfmiddlewaretoken': getCSRFToken(),
  };

  $.ajax({
    type: 'POST',
    url: '/ajax/assign-tags/',
    data: data,
    success: function(response) {
      $('#selected_tags').attr('value',existing_tags);
      $('#existing_tags').dropdown('set exactly', existing_tags);
      $('body').toast({
              class: 'success',
              message: 'Tags assigned successfully!',
              showProgress: 'bottom',
              displayTime: 5000,
            });
      $('#new_tag').val('');
      $('#modal_assign_tags').modal('hide');
    },
    error: function(error) {
      var obj = JSON.parse(error.responseText)
      $('body').toast({
              class: 'error',
              message: obj.message,
              showProgress: 'bottom',
              displayTime: 5000,
            });
    }
  });
}

function copyToClipboardUID(url) {
  var TempText = document.createElement("input");
  TempText.value = url;
  document.body.appendChild(TempText);
  TempText.select();
  document.execCommand("copy");
  document.body.removeChild(TempText);
  $('body')
  .toast({
    class: 'success',
    message: 'Copied'
  });
}



$(document).ready(function() {
  var AjaxRequestOn = false;
  var typingTimer;
  var debounceDelay = 600;
  var noMoreContent = false;

  $('#filter-new-items, #filter-hidden-items').prop('checked', false);
  
  initPopups();

  $('#filter-input').on('input', function() {
    clearTimeout(typingTimer);
    var filterText = $(this).val().toLowerCase();
    var newItemsOnly = $('#filter-new-items').is(':checked');
    var showHiddenItems = $('#filter-hidden-items').is(':checked');
    
    typingTimer = setTimeout(function() {
      $('#q_current_page').attr('value', 0);
      noMoreContent = false;
      loadMovies(0, filterText, newItemsOnly, showHiddenItems);
    }, debounceDelay);
  });
  
  // Combined event handler for both checkboxes
  $('#filter-new-items, #filter-hidden-items').on('change', function() {
    var filterText = $('#filter-input').val().toLowerCase();
    var newItemsOnly = $('#filter-new-items').is(':checked');
    var showHiddenItems = $('#filter-hidden-items').is(':checked');
    noMoreContent = false;
    loadMovies(0, filterText, newItemsOnly, showHiddenItems);
  });
  
  function loadMovies(page, filterText, newItemsOnly, showHiddenItems) {
    var sort = $('#sort').attr('value');
    var sortorder = $('#sortorder').attr('value');
    
    if (noMoreContent && page > 0) {
      return;
    }
    
    if (!AjaxRequestOn) {
      AjaxRequestOn = true;
      
      $('#filter-input').closest('.ui.input').addClass('loading');
      $('#filter-new-items, #filter-hidden-items').prop('disabled', true);

      $(document).on('keydown.filterLock', '#filter-input', function(e) {
        e.preventDefault();
        return false;
      });
      
      $.ajax({
        url: "?append=yes&filter=" + encodeURIComponent(filterText) + 
             "&new_items=" + newItemsOnly + 
             "&show_hidden=" + showHiddenItems + 
             "&sort=" + sort + 
             "&sortorder=" + sortorder + 
             "&q_current_page=" + page,
        beforeSend: function() { $('#loading').show(); },
        complete: function() {
          $('#loading').hide();
          AjaxRequestOn = false;
          
          $('#filter-input').closest('.ui.input').removeClass('loading');
          $('#filter-new-items, #filter-hidden-items').prop('disabled', false);
          
          $(document).off('keydown.filterLock');
          
          if (page === 0) {
            $('#filter-input').focus();
          }
          
          // Check if we should preload the next page
          checkAndPreloadNextPage();
        },
        success: function(html){
          if (page == 0) {
            $("#appendcards").html('');
          }
          
          if (html.trim() != "") {
            $("#appendcards").append(html).slideDown();
            $('#q_current_page').attr('value', page);
            $('.ui.dropdown.mdblistarr').dropdown({maxSelections: 10});
            $('.ui.dropdown.notifiarr').dropdown({maxSelections: 10});
            initStaticListIcons();
          } else {
            noMoreContent = true;
          }
          initPopups();
        }
      });
    }
  }

  
  function initStaticListIcons() {
    document.querySelectorAll('input[id^="slist_"]').forEach(function (input) {
      const idParts = input.id.split('_');
      const itemId = idParts[1];
      const mediatype = idParts[2];
      const icon = document.getElementById(`icon_slists_${itemId}_${mediatype}`);

      if (icon) {
        icon.classList.remove('blue', 'grey');

        const cleaned = input.value.replace(/\s+/g, '').replace(/^,|,$/g, '');
        if (cleaned === "") {
          icon.classList.add('grey');
        } else {
          icon.classList.add('blue');
        }
      }
    });
  }

  // Function to check scroll position and preload next page if needed
  function checkAndPreloadNextPage() {
    if (!noMoreContent && !AjaxRequestOn) {
      // Preload when user has scrolled 70% of the way down
      var scrollPosition = $(window).scrollTop() + $(window).height();
      var totalHeight = $(document).height();
      var scrollPercentage = (scrollPosition / totalHeight) * 100;
      
      if (scrollPercentage > 70) {
        var filterText = $('#filter-input').val().toLowerCase();
        var newItemsOnly = $('#filter-new-items').is(':checked');
        var current_page = parseInt($('#q_current_page').attr('value'));
        loadMovies(current_page + 1, filterText, newItemsOnly);
      }
    }
  }
  
  // Throttled scroll handler
  var scrollTimer;
  $(window).on('scroll', function() {
    if (scrollTimer) {
      clearTimeout(scrollTimer);
    }
    
    scrollTimer = setTimeout(function() {
      checkAndPreloadNextPage();
    }, 100);
  });
  
  loadMovies(0, '');
});



</script>







